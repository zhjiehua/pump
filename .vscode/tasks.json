    {
      "label": "Build: HMI",
      "type": "shell",
      "options": { "cwd": "${workspaceFolder}/hmi" },
      "command": "bash",
      "args": [
        "-lc",
        "mkdir -p build bin && (test -f build/Makefile || (cd build && \"${QMAKE:-qmake}\" ../hmi.pro)) && make -C build -j\"$(nproc 2>/dev/null || echo 4)\""
      ],
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          "New-Item -ItemType Directory -Force -Path build,bin | Out-Null; if (-not (Test-Path build\\Makefile)) { Push-Location build; & $env:QMAKE ..\\hmi.pro CONFIG+=release; Pop-Location }; mingw32-make -C build -j$([Environment]::ProcessorCount); exit $LASTEXITCODE"
        ]
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
